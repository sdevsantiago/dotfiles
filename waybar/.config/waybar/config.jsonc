{
	"layer": "top",
	"modules-left": ["custom/power", "hyprland/window"],
	"modules-center": ["hyprland/workspaces"],
	"modules-right": ["battery", "bluetooth", "network", "pulseaudio", "clock"],
	"hyprland/window": {
		"max-length": 100
	},
	"network": {
		"format-wifi": "󰤨 ",
		"format-ethernet": "󰈀 ",
		"format-disconnected": " ",
		"tooltip-format": "{essid} {ipaddr}/{cidr}\n({bandwidthDownBits} 󰇚) ({bandwidthUpBits} 󰕒)",
		"interval": 1
	},
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": " {volume}%",
		"format-icons": {
			"default": ["", "", ""]
		}
	},
	"battery": {
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 20
		},
		"format": "{icon} {capacity}%",
		"format-full": "{icon} {capacity}%",
		"format-charging": " {capacity}%",
		"format-icons": ["", "", "", "", ""]
	},
	"clock": {
		"format": "{:%a, %d. %b  %H:%M.%S}",
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>", // full calendar
		"interval": 1 // update every second
	},
	"custom/power": {
		"format": " ⏻ ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "~/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "shutdown now",
			"reboot": "shutdown -r now",
			"suspend": "systemctl suspend && hyprlock",
			"hibernate": "systemctl hibernate",
			"logout": "kill -9 -1", // kill all processes except this one
			"bios": "systemctl reboot --firmware-setup",
			"lock": "hyprlock"
		}
	}
}
